<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="generator" content="Ehsan's YAML resume renderer">
  {% if application.company %}<meta name="application-company" content="{{ application.company }}">{% endif %}
  {% if application.role %}<meta name="application-role" content="{{ application.role }}">{% endif %}
  <title>{{ resume.name }} - Resume{% if application.role %} - {{ application.role }}{% endif %}</title>
  <style>
{{ stylesheet | safe }}
  </style>
</head>
<body>
  {% macro contact_icon(kind) -%}
    {% if kind == "email" %}
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="M2 6l10 7 10-7"></path></svg>
    {% elif kind == "phone" %}
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.68 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.32 1.85.55 2.81.68A2 2 0 0 1 22 16.92z"></path></svg>
    {% elif kind == "linkedin" %}
      <svg viewBox="0 0 24 24" aria-hidden="true" class="filled"><path d="M6.94 8.5H3.56V21h3.38V8.5zM5.25 3a1.96 1.96 0 1 0 0 3.92 1.96 1.96 0 0 0 0-3.92zM21 21h-3.37v-6.06c0-1.45-.03-3.31-2.02-3.31-2.02 0-2.33 1.58-2.33 3.2V21H9.9V8.5h3.24v1.71h.05c.45-.85 1.56-1.75 3.21-1.75 3.43 0 4.06 2.26 4.06 5.2V21z"></path></svg>
    {% elif kind == "github" %}
      <svg viewBox="0 0 24 24" aria-hidden="true" class="filled"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.03a9.5 9.5 0 0 1 5 0c1.9-1.3 2.75-1.03 2.75-1.03.55 1.37.2 2.39.1 2.64.64.7 1.03 1.6 1.03 2.69 0 3.85-2.34 4.7-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z"></path></svg>
    {% elif kind == "scholar" %}
      <svg viewBox="0 0 24 24" aria-hidden="true" class="filled"><path d="M12 3 1 9l11 6 9-4.91V17h2V9L12 3z"></path><path d="M5 13.18v3.64L12 21l7-4.18v-3.64L12 17l-7-3.82z"></path></svg>
    {% else %}
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
    {% endif %}
  {%- endmacro %}

  <main class="resume">
    <header class="resume-header">
      <h1>{{ resume.name }}</h1>
      <p class="professional-title">{{ resume.professional_title }}</p>
      <div class="contact-grid">
        {% for item in resume.contact %}
          <a class="contact-item" href="{{ item.url }}" target="_blank" rel="noopener noreferrer">
            <span class="contact-icon">{{ contact_icon(item.kind) }}</span>
            <span>{{ item.label }}</span>
          </a>
        {% endfor %}
      </div>
    </header>

    <section>
      <h2>Professional Summary</h2>
      <p class="summary">{{ resume.summary }}</p>
    </section>

    <section>
      <h2>Education</h2>
      {% for item in resume.education %}
        <article class="entry compact-entry">
          <div class="entry-heading">
            <div><strong>{{ item.degree }}</strong><span class="separator"> | </span><span class="organization">{{ item.institution }}{% if item.location %}, {{ item.location }}{% endif %}</span></div>
            <div class="date">{{ item.date }}</div>
          </div>
          {% if item.details %}<div class="supporting">{{ item.details }}</div>{% endif %}
        </article>
      {% endfor %}
    </section>

    <section class="skills-section">
      <h2>Technical Skills</h2>
      {% for item in resume.skills %}
        <div class="skill-row">
          <strong>{{ item.category }}</strong>
          <span>{{ item.details }}</span>
        </div>
      {% endfor %}
    </section>

    <section class="research-section">
      <h2>Research &amp; Engineering Experience</h2>
      {% for item in resume.experience %}
        <article class="experience-entry">
          <div class="entry-heading">
            <div><strong>{{ item.position }}</strong><span class="separator"> | </span><span class="organization">{{ item.organization }}{% if item.location %}, {{ item.location }}{% endif %}</span></div>
            <div class="date">{{ item.date }}</div>
          </div>
          <ul>
            {% for highlight in item.highlights %}
              <li>{{ highlight | richtext }}</li>
            {% endfor %}
          </ul>
        </article>
      {% endfor %}
    </section>

    {% if resume.teaching is defined %}
    <section class="academic-section">
      <h2>Academic Experience</h2>
      {% for item in resume.teaching %}
        <article class="experience-entry">
          <div class="entry-heading">
            <div><strong>{{ item.position }}</strong><span class="separator"> | </span><span class="organization">{{ item.organization }}{% if item.location %}, {{ item.location }}{% endif %}</span></div>
            <div class="date">{{ item.date }}</div>
          </div>
          <ul>
            {% for highlight in item.highlights %}
              <li>{{ highlight | richtext }}</li>
            {% endfor %}
          </ul>
        </article>
      {% endfor %}
    </section>
    {% endif %}

    <section>
      <h2>Honors and Awards</h2>
      {% for item in resume.honors %}
        <div class="honor-entry">
          <div class="dated-row">
            <span><strong>{{ item.name }}</strong></span>
            <span class="date">{{ item.date }}</span>
          </div>
          {% if item.details %}<div class="supporting">{{ item.details | richtext }}</div>{% endif %}
        </div>
      {% endfor %}
    </section>

    <section>
      <h2>Leadership &amp; Service</h2>

      {% for item in resume.leadership %}
        <div class="leadership-entry">
          <div class="dated-row">
            <span>
              <strong>{{ item.position }}</strong>, {{ item.organization }}
            </span>
            <span class="date">{{ item.date }}</span>
          </div>

          {% if item.highlights %}
            <ul>
              {% for highlight in item.highlights %}
                <li>{{ highlight | richtext }}</li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      {% endfor %}
    </section>

    <section class="publications-section">
      <h2>Publications</h2>
      <ul>
        {% for item in resume.publications["items"] %}
          <li>{{ item.authors | richtext }}. &ldquo;{{ item.title }}.&rdquo; <em>{{ item.venue }}</em> ({{ item.year }}).</li>
        {% endfor %}
      </ul>
    </section>
  </main>
</body>
</html>
